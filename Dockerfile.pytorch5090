# 使用本地已下载的PyTorch 5090镜像
FROM crpi-ut0apwr713irl7gy.cn-hangzhou.personal.cr.aliyuncs.com/my_english/pytorch-5090:25.01

# 设置环境变量
ENV PYTHONUNBUFFERED=1
ENV TOKENIZERS_PARALLELISM=false

# 设置工作目录
WORKDIR /workspace

# 复制requirements.txt并安装Python依赖
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# 创建模型缓存目录
RUN mkdir -p /root/.cache/huggingface/hub

# 复制项目代码
COPY . .

# 创建必要的目录
RUN mkdir -p /workspace/data /workspace/models /workspace/logs

# 设置默认命令
CMD ["python", "train_multi_gpu.py"]
